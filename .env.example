# Exemplo somente: substitua os placeholders em um .env local antes de conectar.
# O .env real permanece ignorado pelo Git. Nenhuma credencial real neste arquivo.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/psicotask?schema=public"

# Apenas placeholders. Configure os valores reais somente no .env local ignorado.
# AUTH_SECRET deve conter um segredo aleatório de pelo menos 32 bytes.
AUTH_SECRET="defina-um-segredo-local-forte"
DEV_PSYCHOLOGIST_PASSWORD="defina-uma-senha-local"
